# ─── Explore Shirdi Backend — Environment Config ─────────────────────────────
# DATABASE: Using SQLite (no PostgreSQL install needed for local dev)

APP_NAME=Explore Shirdi API
APP_ENV=development
DEBUG=true
SECRET_KEY=shirdi-sai-baba-secret-key-2026-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── SQLite Database (Active) ─────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./explore_shirdi.db
DATABASE_SYNC_URL=sqlite:///./explore_shirdi.db

# ─── PostgreSQL (for production only — uncomment when deploying) ─────────────
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/explore_shirdi
# DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/explore_shirdi

# ─── Optional API Keys (leave blank if not used) ──────────────
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
AI_PROVIDER=gemini

OPENWEATHER_API_KEY=
SHIRDI_LAT=19.7664
SHIRDI_LON=74.4762
WEATHER_UPDATE_INTERVAL_SECONDS=600

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

QUEUE_UPDATE_INTERVAL_SECONDS=30
SANCTUM_OCCUPANCY_UPDATE_SECONDS=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ⚠️ Administrator account (created on startup, server-side only).
# Change ADMIN_PASSWORD before deploying — the value below is a local-dev default.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@shirdi.org
ADMIN_PASSWORD=Admin@1234

# Razorpay (https://razorpay.com). Leave empty to run payments in MOCK mode
# (orders are created locally and every verification is accepted, so the full
# book -> pay -> confirm flow works without a real Razorpay account).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# UPI QR payment flow. The merchant UPI id is encoded into a QR code
# that pilgrims scan with any UPI app (PhonePe, GPay, Paytm). Scanning
# opens the app with the payment pre-filled; after paying, the pilgrim
# submits the UTR number which is verified server-side.
MERCHANT_UPI_ID=ahiretejas32-3@okhdfcbank
MERCHANT_NAME=Explore Shirdi

