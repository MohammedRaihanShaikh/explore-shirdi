# ──────────────────────────────────────────────
#  Explore Shirdi Backend — Environment Config
# ──────────────────────────────────────────────

# Application
APP_NAME="Explore Shirdi API"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/explore_shirdi
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/explore_shirdi

# Redis (for WebSocket pub/sub + caching)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# AI / LLM  (choose one or both)
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
AI_PROVIDER=gemini   # options: openai | gemini

# Weather API (OpenWeatherMap - free tier)
OPENWEATHER_API_KEY=your-openweather-api-key-here
SHIRDI_LAT=19.7664
SHIRDI_LON=74.4762
WEATHER_UPDATE_INTERVAL_SECONDS=600

# Twilio (WhatsApp + SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Darshan Queue Simulation (replace with real Sansthan API if available)
QUEUE_UPDATE_INTERVAL_SECONDS=30
SANCTUM_OCCUPANCY_UPDATE_SECONDS=60

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
